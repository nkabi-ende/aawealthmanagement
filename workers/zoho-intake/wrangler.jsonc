{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aawealth-zoho-intake",
  "main": "index.ts",
  "compatibility_date": "2026-11-05",
  "vars": { "ENABLED": "false" },
  "durable_objects": { "bindings": [{ "name": "INTAKE", "class_name": "IntakeInbox" }] },
